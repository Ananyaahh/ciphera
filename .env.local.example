# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored by Next.js — never commit real secrets.

# ---- Phone OTP via Twilio Verify ----
# Leave these BLANK to keep the built-in demo mode (code shown on screen,
# no real SMS). Fill all three to send real SMS codes.
# Get them from https://console.twilio.com  (Verify > Services creates the SID).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Continue with Google ----
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# The SAME client id goes in both variables below.
# NEXT_PUBLIC_ is required for the value the browser button reads.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
